# ─── Super Data Extractor — environment ──────────────────────────────────────
# Copy to `.env` and edit. NEVER commit your real .env file.

# HTTP -----------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# CORS — comma-separated list of allowed origins. Empty = same-origin only.
# In production this MUST be set to your real origin(s), e.g.
#   ALLOWED_ORIGIN=https://leads.example.com,https://app.example.com
ALLOWED_ORIGIN=

# Set to 1 if running behind nginx/Cloudflare/etc. so X-Forwarded-For is honored.
TRUST_PROXY=0

# Set to 1 in production behind HTTPS to enable HSTS.
FORCE_HTTPS=0

# Logging --------------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
LOG_REDACT=1

# Storage --------------------------------------------------------------------
DATA_DIR=./data

# Crypto (REQUIRED in production) -------------------------------------------
# 32 random bytes, base64 OR hex. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Used to encrypt user API keys at rest with AES-256-GCM.
MASTER_KEY=

# Sessions -------------------------------------------------------------------
SESSION_TTL_DAYS=30

# Cost meter -----------------------------------------------------------------
# USD → INR conversion. If unset, falls back to 84.
USD_TO_INR=84

# Per-user daily INR ceiling (0 = disabled). Search refuses if estimate would
# push spend above this for the day.
DEFAULT_DAILY_INR_CEILING=0

# Rate limits ----------------------------------------------------------------
RL_LOGIN_PER_IP_15M=5
RL_REGISTER_PER_IP_1H=3
RL_SEARCH_PER_USER_1H=30
RL_VALIDATE_PER_USER_1H=60
RL_ENRICHMENT_PER_USER_1H=200
RL_API_V1_PER_KEY_1M=60

# Enrichment -----------------------------------------------------------------
ENRICHMENT_ENABLED=1
ENRICHMENT_DOMAIN_DELAY_MS=1500
ENRICHMENT_TIMEOUT_MS=8000
ENRICHMENT_MAX_BYTES=1048576
# ENRICHMENT_USER_AGENT="MyBot/1.0 (+https://example.com/bot)"

# SSRF guard (DEV ONLY ESCAPE HATCH) -----------------------------------------
# Set to 1 to permit fetching localhost / private IPs from the server. Useful
# when self-hosting against private intranets. Leave unset in production.
SSRF_ALLOW_PRIVATE=0
